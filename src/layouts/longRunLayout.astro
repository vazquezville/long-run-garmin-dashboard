---
import "@fontsource-variable/figtree/wght.css";
import "../styles/longRun.css";

interface Props {
  title: string;
  errors?: Array<string | null | undefined>;
}

const { title, errors = [] } = Astro.props;
const failures = errors.filter((error) => error != null);
const loadedAt = new Date().toLocaleString("en-US", { dateStyle: "medium", timeStyle: "short", hourCycle: "h23" });
// Runs and Health still point at the previous pages
const links = [
  { href: "/", label: "Training" },
  { href: "/activities", label: "Runs" },
  { href: "/daily", label: "Health", isQuiet: true },
];
// A single run belongs to the Runs section
const section = Astro.url.pathname.startsWith("/run/") ? "/activities" : Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#ff5a1f" />
    <title>{title} | Long Run</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <div class="field">
      <div class="wrap">
        <header>
          <a class="brand condensed" href="/">Long Run</a>
          <nav aria-label="Sections">
            {links.map((link) => (
              <a class:list={{ isQuiet: link.isQuiet }} href={link.href} aria-current={link.href === section ? "true" : undefined}>
                {link.label}
              </a>
            ))}
          </nav>
        </header>
        {failures.length > 0 && (
          <div class="failures" role="alert">
            {failures.map((failure) => <p>{failure}</p>)}
          </div>
        )}
        <slot name="field" />
      </div>
    </div>
    <main>
      <slot />
    </main>
    <footer>
      <p class="wrap muted">Data from the Garmin Connect Personal API, page generated {loadedAt}.</p>
    </footer>
    <div class="tooltip" id="tooltip" role="status" hidden></div>
    <script>
      import "../scripts/tooltip.ts";
    </script>
  </body>
</html>

<style>
  .field {
    padding: 18px 0 36px;
    background: var(--field);
  }

  header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  a {
    text-decoration: none;
  }

  .brand {
    font-size: 34px;
  }

  nav {
    display: flex;
    gap: 6px;
  }

  nav a {
    padding: 8px 18px;
    border: 1.5px solid transparent;
    border-radius: 99px;
    font-weight: 700;
  }

  nav a.isQuiet {
    border-color: rgba(0, 0, 0, 0.35);
    font-weight: 500;
  }

  nav a[aria-current] {
    background: var(--ink);
    color: var(--paper);
  }

  .failures {
    margin-top: 18px;
    padding: 12px 18px;
    border-radius: 6px;
    background: var(--paper);
    font-weight: 600;
  }

  footer {
    padding: 16px 0 40px;
    background: var(--quiet);
    font-size: 12px;
  }
</style>
