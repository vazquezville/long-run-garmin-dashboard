---
import "@fontsource-variable/archivo/standard.css";
import "../styles/tokens.css";
import "../styles/global.css";
import RangeSwitch from "../components/rangeSwitch.astro";
import SiteHeader from "../components/siteHeader.astro";
import { defaultRange, rangeOptions } from "../lib/views.ts";

interface Props {
  title: string;
  errors?: Array<string | null>;
  hasRange?: boolean;
}

const { title, errors = [], hasRange = true } = Astro.props;
const failures = errors.filter((error) => error != null);
const loadedAt = new Date().toLocaleString("en-US", { dateStyle: "medium", timeStyle: "short", hourCycle: "h23" });
---

<!doctype html>
<html lang="en" data-range={defaultRange}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title} | Logbook</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Applies saved preferences before the first paint -->
    <script is:inline define:vars={{ ranges: rangeOptions.map(String) }}>
      try {
        const theme = localStorage.getItem("theme");
        const range = localStorage.getItem("range");
        if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
        if (ranges.includes(range)) document.documentElement.dataset.range = range;
      } catch {}
    </script>
  </head>
  <body>
    <SiteHeader />
    <main class="container stack">
      <div class="pageHead">
        <h1>{title}</h1>
        {hasRange && <RangeSwitch />}
        <slot name="actions" />
      </div>
      {failures.length > 0 && (
        <div class="notice" role="alert">
          {failures.map((failure) => <p>{failure}</p>)}
        </div>
      )}
      <slot />
    </main>
    <footer class="container muted">Data from the Garmin Connect Personal API, page generated {loadedAt}.</footer>
    <div class="tooltip" id="tooltip" role="status" hidden></div>
    <script>
      import "../scripts/preferences.ts";
      import "../scripts/tooltip.ts";
    </script>
  </body>
</html>

<style>
  .pageHead {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: -16px;
    padding-top: 36px;
  }

  footer {
    margin-top: 56px;
    padding: 16px 0 40px;
    border-top: 1px solid var(--grid);
    font-size: 12px;
  }
</style>
