---
import type { Activity } from "../lib/data/types.ts";
import { formatClock, formatDuration, formatNumber, formatWeekday } from "../lib/format.ts";
import { sports } from "../lib/sports.ts";
import EmptyState from "./emptyState.astro";

interface Props {
  activities: Activity[];
}

const { activities } = Astro.props;

// Runners and walkers read pace, other sports read speed
function effort(activity: Activity): string {
  if (activity.distanceKm === 0) return "–";
  if (activity.sport === "run" || activity.sport === "walk") {
    return activity.paceSecPerKm ? `${formatClock(activity.paceSecPerKm)} /km` : "–";
  }
  return activity.speedKmh ? `${formatNumber(activity.speedKmh, 1)} km/h` : "–";
}
---

<div class="block">
  {activities.length === 0 ? (
    <EmptyState message="No activities in this period. Pick a longer range to see earlier sessions." />
  ) : (
    <div class="tableScroll">
      <table>
        <thead>
          <tr>
            <th scope="col">Activity</th>
            <th scope="col">Distance</th>
            <th scope="col">Time</th>
            <th scope="col">Pace or speed</th>
            <th scope="col">Avg HR</th>
            <th scope="col">Climb</th>
            <th scope="col">Load</th>
          </tr>
        </thead>
        <tbody>
          {activities.map((activity) => (
            <tr>
              <td>
                <span class="name">
                  <span class="swatch" style={`--color: ${sports[activity.sport].color}`} title={sports[activity.sport].label} />
                  {activity.name}
                </span>
                <span class="when">
                  {sports[activity.sport].label}, {formatWeekday(activity.date)} at {activity.time}
                </span>
              </td>
              <td>{activity.distanceKm > 0 ? `${formatNumber(activity.distanceKm, 2)} km` : "–"}</td>
              <td>{formatDuration(activity.durationSec)}</td>
              <td>{effort(activity)}</td>
              <td>{formatNumber(activity.avgHr)}</td>
              <td>{activity.elevationGain == null ? "–" : `${formatNumber(activity.elevationGain)} m`}</td>
              <td>{formatNumber(activity.trainingLoad)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</div>

<style>
  .tableScroll {
    max-height: 560px;
  }

  thead th {
    position: sticky;
    top: 0;
    background: var(--surface);
  }

  /* Phones keep the name, distance and time */
  @media (max-width: 640px) {
    td:first-child {
      white-space: normal;
    }

    th:nth-child(n + 4),
    td:nth-child(n + 4) {
      display: none;
    }
  }

  .name {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
  }

  .when {
    display: block;
    padding-left: 18px;
    color: var(--textMuted);
    font-size: 12px;
  }
</style>
