---
import { sum } from "../../lib/data/aggregate.ts";
import type { RunDetail } from "../../lib/data/runDetail.ts";
import type { Activity } from "../../lib/data/types.ts";
import { formatClock, formatNumber } from "../../lib/format.ts";
import ZoneBars from "../zoneBars.astro";

interface Props {
  run: Activity;
  detail: RunDetail | null;
}

const { run, detail } = Astro.props;
const total = sum(run.zoneSec);
const figures = [
  { label: "Training load", value: formatNumber(run.trainingLoad) },
  { label: "Aerobic effect, of 5", value: formatNumber(detail?.aerobicEffect ?? null, 1) },
  { label: "Anaerobic effect, of 5", value: formatNumber(detail?.anaerobicEffect ?? null, 1) },
  { label: "Maximum heart rate", value: formatNumber(detail?.maxHr ?? null) },
  { label: "Grade adjusted pace", value: formatClock(detail?.gradePaceSecPerKm ?? null) },
  { label: "Calories", value: formatNumber(run.calories) },
].filter((figure) => figure.value !== "–");
---

{(figures.length > 0 || total > 0) && (
<section class="band">
  <div class="wrap">
    <h2>Effort</h2>
    <dl>
      {figures.map((figure) => (
        <div>
          <dt>{figure.label}</dt>
          <dd class="condensed">{figure.value}</dd>
        </div>
      ))}
    </dl>
    {total > 0 && (
      <>
        <h3 class="condensed">Time in heart rate zones</h3>
        <ZoneBars seconds={run.zoneSec} />
      </>
    )}
  </div>
</section>
)}

<style>
  dl {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 20px 16px;
  }

  dl div {
    display: flex;
    flex-direction: column;
  }

  /* The figure reads first, above its label */
  dd {
    order: -1;
    font-size: 56px;
  }

  h3 {
    margin: 32px 0 12px;
    font-size: 30px;
  }

  @media (max-width: 900px) {
    dl {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    dd {
      font-size: 40px;
    }
  }
</style>
