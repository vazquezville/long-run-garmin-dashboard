---
const options = [
  { value: "system", label: "Auto" },
  { value: "light", label: "Light" },
  { value: "dark", label: "Dark" },
];
---

<div role="group" aria-label="Color theme">
  {options.map((option) => (
    <button type="button" data-theme-option={option.value} aria-pressed={option.value === "system" ? "true" : "false"}>
      {option.label}
    </button>
  ))}
</div>

<style>
  div {
    display: flex;
    gap: 2px;
    padding: 2px;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 8px;
  }

  button {
    padding: 3px 10px;
    border: 0;
    border-radius: 5px;
    background: transparent;
    color: var(--trackText);
    font: inherit;
    font-size: 13px;
    cursor: pointer;
  }

  button[aria-pressed="true"] {
    background: var(--trackText);
    color: var(--track);
    font-weight: 700;
  }

  button:focus-visible {
    outline-color: var(--trackText);
  }
</style>
