---
import { average, formAverage, type FormMetric } from "../../lib/data/aggregate.ts";
import type { Activity, Vo2Reading } from "../../lib/data/types.ts";
import { formatCount, formatDay, formatNumber } from "../../lib/format.ts";
import { bucketUnit, periodBuckets, type Period } from "../../lib/trainingPeriod.ts";
import { within } from "../../lib/views.ts";
import MetricExplorer from "../metricExplorer.astro";

interface Props {
  period: Period;
  today: string;
  // Runs inside the period
  runs: Activity[];
  // Readings up to the end of the period, which may start earlier
  vo2: Vo2Reading[];
}

const { period, today, runs, vo2 } = Astro.props;
const buckets = periodBuckets(period, today);
const unitName = bucketUnit(period);

// The margin keeps small changes from looking dramatic
const metrics: Array<[metric: FormMetric, label: string, unit: string, digits: number, margin: number]> = [
  ["cadence", "Cadence", "spm", 0, 5],
  ["strideM", "Stride length", "m", 2, 0.05],
  ["groundContactMs", "Ground contact", "ms", 0, 10],
  ["oscillationCm", "Vertical oscillation", "cm", 1, 0.5],
  ["verticalRatio", "Vertical ratio", "%", 1, 0.5],
  ["powerW", "Power", "W", 0, 20],
];

function toChart(label: string, unit: string, digits: number, margin: number, mean: number | null, values: Array<{ value: number | null; runs?: number }>) {
  const recorded = values.flatMap(({ value }) => (value == null ? [] : [value]));
  if (mean == null || recorded.length === 0) return null;
  return {
    title: `${label} by ${unitName}`,
    reference: mean,
    note: `The dashed line is the period average, ${formatNumber(mean, digits)} ${unit}`,
    domain: [Math.min(...recorded) - margin, Math.max(...recorded) + margin] as [number, number],
    formatTick: (value: number) => formatNumber(value, digits),
    points: buckets.map((bucket, index) => {
      const { value, runs: count } = values[index]!;
      return {
        label: bucket.label,
        value,
        tip: {
          title: bucket.title,
          rows:
            value == null
              ? [{ label: "", value: bucket.isFuture ? "Still to come" : "No reading" }]
              : [{ label: unit, value: formatNumber(value, digits) }, ...(count ? [{ label: "", value: formatCount(count, "run") }] : [])],
        },
      };
    }),
  };
}

const formFigures = metrics.map(([metric, label, unit, digits, margin]) => {
  const mean = formAverage(runs, metric);
  const values = buckets.map((bucket) => {
    const items = within(runs, bucket);
    return { value: formAverage(items, metric), runs: items.filter((run) => run.form[metric] != null).length };
  });
  return { id: metric as string, label, unit, value: formatNumber(mean, digits), chart: toChart(label, unit, digits, margin, mean, values) };
});

// The figure shows the latest reading, the chart averages the period
const latest = vo2.at(-1);
const readings = within(vo2, period);
const vo2Values = buckets.map((bucket) => ({ value: average(within(readings, bucket).map((reading) => reading.value)) }));
const figures = [
  ...formFigures,
  {
    id: "vo2",
    label: "VO2 max",
    unit: latest ? `On ${formatDay(latest.date)}` : "No reading",
    value: formatNumber(latest?.value ?? null, 1),
    chart: toChart("VO2 max", "ml/kg/min", 1, 1, average(readings.map((reading) => reading.value)), vo2Values),
  },
];
---

<section class="band">
  <div class="wrap">
    <h2>Running form</h2>
    <p class="hint muted">{figures.some((figure) => figure.chart) ? "Select a figure to see how it changed." : "No running form data in this period."}</p>
    <MetricExplorer name="training" metrics={figures} />
  </div>
</section>

<style>
  .hint {
    margin: -8px 0 16px;
  }
</style>
