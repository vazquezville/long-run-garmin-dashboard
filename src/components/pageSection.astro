---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section>
  <h2>{title}</h2>
  <slot />
</section>

<style>
  /* The heavy rule marks where each group starts, like a start line */
  section {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
    margin-top: 24px;
    padding-top: 14px;
    border-top: 2px solid var(--text);
  }
</style>
