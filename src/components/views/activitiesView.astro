---
import { bucketByDate, overallPace, sum } from "../../lib/data/aggregate.ts";
import type { Activity } from "../../lib/data/types.ts";
import { formatClock, formatCount, formatDay, formatDuration, formatNumber, formatWeekday } from "../../lib/format.ts";
import { lastDays } from "../../lib/garmin/ranges.ts";
import { sports } from "../../lib/sports.ts";
import { within, type Range } from "../../lib/views.ts";
import ActivityTable from "../activityTable.astro";
import ChartPanel from "../charts/chartPanel.astro";
import LineChart from "../charts/lineChart.astro";
import PageSection from "../pageSection.astro";
import EffortsPanel from "../panels/effortsPanel.astro";
import RunDistancePanel from "../panels/runDistancePanel.astro";
import RunFormPanel from "../panels/runFormPanel.astro";
import SportsPanel from "../panels/sportsPanel.astro";
import TimeBySportPanel from "../panels/timeBySportPanel.astro";
import ZonesPanel from "../panels/zonesPanel.astro";
import ResultsLine from "../resultsLine.astro";

interface Props {
  range: Range;
  today: string;
  activities: Activity[];
}

const { range, today, activities } = Astro.props;
const period = lastDays(range, today);
const done = within(activities, period);
const runs = done.filter((activity) => activity.sport === "run");
const longest = runs.toSorted((a, b) => b.distanceKm - a.distanceKm)[0];

const stats = [
  { label: "Running distance", value: formatNumber(sum(runs.map((run) => run.distanceKm)), 1), unit: " km", detail: `${formatCount(runs.length, "run")} in ${range} days` },
  { label: "Average running pace", value: formatClock(overallPace(runs)), unit: " /km" },
  { label: "Active time", value: formatDuration(sum(done.map((item) => item.durationSec))), detail: formatCount(done.length, "activity") },
  { label: "Longest run", value: formatNumber(longest?.distanceKm ?? null, 1), unit: " km", detail: longest && formatWeekday(longest.date) },
  { label: "Activity calories", value: formatNumber(sum(done.map((activity) => activity.calories))), unit: " kcal" },
];

function group(unit: "day" | "week") {
  return {
    per: `per ${unit}`,
    column: unit === "day" ? "Day" : "Week of",
    buckets: bucketByDate(done, period, unit).map((bucket) => ({
      ...bucket,
      label: formatDay(bucket.start),
      title: unit === "day" ? formatWeekday(bucket.start) : `Week of ${formatDay(bucket.start)}${bucket.isPartial ? ", partial" : ""}`,
    })),
  };
}

// The lead chart shows days while they stay readable
const time = group(range === 90 ? "week" : "day");
const distance = group(range === 7 ? "day" : "week");

const paced = runs.filter((run) => run.paceSecPerKm != null).toReversed();
const pacePoints = paced.map((run) => ({
  label: formatDay(run.date),
  value: run.paceSecPerKm,
  tip: {
    title: formatWeekday(run.date),
    rows: [
      { label: "/km", value: formatClock(run.paceSecPerKm), color: sports.run.color },
      { label: "km", value: formatNumber(run.distanceKm, 1) },
      { label: "bpm", value: formatNumber(run.avgHr) },
    ],
  },
}));

const noRuns = runs.length === 0 && "No runs in this period.";
---

<ResultsLine stats={stats} />
<TimeBySportPanel title={`Time ${time.per}`} unit={time.column} buckets={time.buckets} height={280} isLead />
<PageSection title="Running">
  <div class="twoColumns">
    <RunDistancePanel
      title={`Distance ${distance.per}`}
      unit={distance.column}
      note={`In kilometers${distance.buckets.some((bucket) => bucket.isPartial) ? ", faded weeks are partial" : ""}`}
      buckets={distance.buckets}
    />
    <ChartPanel
      title="Pace"
      note="Minutes per kilometer for each run, faster is higher"
      table={{
        head: ["Date", "Pace", "km", "Avg HR"],
        rows: paced.toReversed().map((run) => [formatWeekday(run.date), formatClock(run.paceSecPerKm), formatNumber(run.distanceKm, 1), formatNumber(run.avgHr)]),
      }}
      empty={noRuns}
    >
      <LineChart points={pacePoints} summary="Pace of each run" color={sports.run.color} formatTick={formatClock} isInverted />
    </ChartPanel>
  </div>
  <RunFormPanel activities={done} period={period} />
</PageSection>
<PageSection title="Effort">
  <div class="threeColumns">
    <ZonesPanel activities={done} />
    <SportsPanel activities={done} />
    <EffortsPanel activities={done} />
  </div>
</PageSection>
<PageSection title="All activities">
  <ActivityTable activities={done} />
</PageSection>
