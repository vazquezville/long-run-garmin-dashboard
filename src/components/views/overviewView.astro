---
import { sum } from "../../lib/data/aggregate.ts";
import type { Activity, Day, FitnessAge, Vo2Reading } from "../../lib/data/types.ts";
import { formatCount, formatDay, formatDuration, formatNumber } from "../../lib/format.ts";
import { lastDays } from "../../lib/garmin/ranges.ts";
import { within, type Range } from "../../lib/views.ts";
import BatteryChart from "../metrics/batteryChart.astro";
import RestingHrChart from "../metrics/restingHrChart.astro";
import StepsChart from "../metrics/stepsChart.astro";
import StressChart from "../metrics/stressChart.astro";
import PageSection from "../pageSection.astro";
import ResultsLine from "../resultsLine.astro";
import TrainingLog from "../trainingLog.astro";

interface Props {
  range: Range;
  today: string;
  activities: Activity[];
  days: Day[];
  vo2: Vo2Reading[];
  fitnessAge: FitnessAge | null;
}

const { range, today, activities, days, vo2, fitnessAge } = Astro.props;
const period = lastDays(range, today);
const done = within(activities, period);
const shown = within(days, period);
const runs = done.filter((activity) => activity.sport === "run");
const latestVo2 = vo2.at(-1);

const stats = [
  { label: "Running distance", value: formatNumber(sum(runs.map((run) => run.distanceKm)), 1), unit: " km", detail: `${formatCount(runs.length, "run")} in ${range} days` },
  { label: "Active time", value: formatDuration(sum(done.map((activity) => activity.durationSec))), detail: formatCount(done.length, "activity") },
  { label: "VO2 max", value: formatNumber(latestVo2?.value ?? null, 1), detail: latestVo2 && `Measured ${formatDay(latestVo2.date)}` },
  {
    label: "Fitness age",
    value: formatNumber(fitnessAge ? Math.floor(fitnessAge.fitnessAge) : null),
    detail: fitnessAge ? `Actual age ${fitnessAge.age}` : undefined,
  },
];
---

<ResultsLine stats={stats} />
<TrainingLog activities={done} range={period} />
<PageSection title="Body">
  <div class="twoColumns">
    <StepsChart days={shown} />
    <RestingHrChart days={shown} />
    <BatteryChart days={shown} />
    <StressChart days={shown} />
  </div>
</PageSection>
