---
import { average, bucketByDate, sum } from "../../lib/data/aggregate.ts";
import type { Day } from "../../lib/data/types.ts";
import { formatCount, formatDay, formatNumber, formatWeekday } from "../../lib/format.ts";
import { lastDays } from "../../lib/garmin/ranges.ts";
import { within, type Range } from "../../lib/views.ts";
import ChartPanel from "../charts/chartPanel.astro";
import ColumnChart from "../charts/columnChart.astro";
import RestingHrChart from "../metrics/restingHrChart.astro";
import StepsChart from "../metrics/stepsChart.astro";
import PageSection from "../pageSection.astro";
import ResultsLine from "../resultsLine.astro";

interface Props {
  range: Range;
  today: string;
  days: Day[];
}

const { range, today, days } = Astro.props;
const period = lastDays(range, today);
const shown = within(days, period);
const completed = shown.filter((day) => !day.isToday);
const tracked = completed.filter((day) => day.steps != null);
const reached = tracked.filter((day) => day.stepGoal != null && day.steps! >= day.stepGoal);

// Garmin counts every vigorous minute twice
const intensity = (day: Day) => (day.moderateMin ?? 0) + 2 * (day.vigorousMin ?? 0);
const active = completed.filter((day) => day.moderateMin != null);
const weeklyIntensity = active.length ? (sum(active.map(intensity)) / active.length) * 7 : null;

const stats = [
  { label: "Daily steps", value: formatNumber(average(tracked.map((day) => day.steps))), detail: "Average" },
  { label: "Step goal reached", value: formatNumber(reached.length), unit: ` of ${formatCount(tracked.length, "day")}` },
  { label: "Active calories", value: formatNumber(average(completed.map((day) => day.activeKcal))), unit: " kcal", detail: "Daily average" },
  { label: "Intensity minutes", value: formatNumber(weeklyIntensity), detail: "Weekly average" },
  { label: "Distance on foot", value: formatNumber(sum(shown.map((day) => day.distanceKm))), unit: " km", detail: "Total, all steps" },
];

const calorieParts = [
  { label: "Resting", color: "var(--resting)" },
  { label: "Active", color: "var(--steps)" },
];
const calorieColumns = shown.map((day) => ({
  label: formatDay(day.date),
  isMuted: day.isToday,
  segments: [
    { value: day.restingKcal ?? 0, color: calorieParts[0]!.color },
    { value: day.activeKcal ?? 0, color: calorieParts[1]!.color },
  ],
  tip: {
    title: `${formatWeekday(day.date)}${day.isToday ? ", so far" : ""}`,
    rows: [
      { label: "resting kcal", value: formatNumber(day.restingKcal), color: calorieParts[0]!.color },
      { label: "active kcal", value: formatNumber(day.activeKcal), color: calorieParts[1]!.color },
    ],
  },
}));

const unit = range === 7 ? "day" : "week";
const intensityParts = [
  { label: "Moderate", color: "var(--zone2)" },
  { label: "Vigorous, counted twice", color: "var(--zone4)" },
];
const intensityBuckets = bucketByDate(shown, period, unit).map((bucket) => ({
  label: formatDay(bucket.start),
  title: unit === "day" ? formatWeekday(bucket.start) : `Week of ${formatDay(bucket.start)}${bucket.isPartial ? ", partial" : ""}`,
  isPartial: bucket.isPartial,
  moderate: sum(bucket.items.map((day) => day.moderateMin)),
  vigorous: 2 * sum(bucket.items.map((day) => day.vigorousMin)),
}));
const intensityColumns = intensityBuckets.map((bucket) => ({
  label: bucket.label,
  isMuted: bucket.isPartial,
  segments: [
    { value: bucket.moderate, color: intensityParts[0]!.color },
    { value: bucket.vigorous, color: intensityParts[1]!.color },
  ],
  tip: {
    title: bucket.title,
    rows: [
      { label: "moderate", value: formatNumber(bucket.moderate), color: intensityParts[0]!.color },
      { label: "vigorous", value: formatNumber(bucket.vigorous), color: intensityParts[1]!.color },
      { label: "total", value: formatNumber(bucket.moderate + bucket.vigorous) },
    ],
  },
}));
const weeklyGoal = shown.findLast((day) => day.intensityGoal != null)?.intensityGoal;
---

<ResultsLine stats={stats} />
<StepsChart days={shown} height={280} isLead />
<PageSection title="Energy and heart">
  <div class="threeColumns">
    <ChartPanel
      title="Calories"
      note="Burned per day"
      legend={calorieParts}
      table={{
        head: ["Date", "Resting", "Active"],
        rows: shown.toReversed().map((day) => [formatWeekday(day.date), formatNumber(day.restingKcal), formatNumber(day.activeKcal)]),
      }}
      empty={!shown.some((day) => day.activeKcal != null) && "No calorie data in this period."}
    >
      <ColumnChart columns={calorieColumns} summary="Calories burned per day" />
    </ChartPanel>
    <ChartPanel
      title={`Intensity minutes per ${unit}`}
      note={unit === "week" && weeklyGoal ? `The line marks the weekly goal of ${weeklyGoal}` : undefined}
      legend={intensityParts}
      table={{
        head: [unit === "day" ? "Day" : "Week of", "Moderate", "Vigorous ×2"],
        rows: intensityBuckets.toReversed().map((bucket) => [bucket.label, formatNumber(bucket.moderate), formatNumber(bucket.vigorous)]),
      }}
      empty={active.length === 0 && "No intensity minutes in this period."}
    >
      <ColumnChart
        columns={intensityColumns}
        summary={`Intensity minutes per ${unit}`}
        goal={unit === "week" ? (weeklyGoal ?? undefined) : undefined}
      />
    </ChartPanel>
    <RestingHrChart days={shown} />
  </div>
</PageSection>
