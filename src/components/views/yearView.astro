---
import { average, bucketByMonth, latestPerWeek, sum } from "../../lib/data/aggregate.ts";
import type { Activity, Day, Night, Vo2Reading } from "../../lib/data/types.ts";
import { formatCount, formatDay, formatDuration, formatMonthName, formatMonthTitle, formatNumber, formatWeekday } from "../../lib/format.ts";
import type { DateRange } from "../../lib/garmin/ranges.ts";
import ChartPanel from "../charts/chartPanel.astro";
import ColumnChart from "../charts/columnChart.astro";
import LineChart from "../charts/lineChart.astro";
import MonthTable from "../monthTable.astro";
import EffortsPanel from "../panels/effortsPanel.astro";
import RunDistancePanel from "../panels/runDistancePanel.astro";
import RunFormPanel from "../panels/runFormPanel.astro";
import SportsPanel from "../panels/sportsPanel.astro";
import TimeBySportPanel from "../panels/timeBySportPanel.astro";
import ZonesPanel from "../panels/zonesPanel.astro";
import PageSection from "../pageSection.astro";
import ResultsLine from "../resultsLine.astro";
import YearHeatmap from "../yearHeatmap.astro";

interface Props {
  today: string;
  // Whole year, including days still to come
  calendar: DateRange;
  // Year up to today
  period: DateRange;
  months: string[];
  activities: Activity[];
  days: Day[];
  nights: Night[];
  vo2: Vo2Reading[];
}

const { today, calendar, period, months, activities, days, nights, vo2 } = Astro.props;
const runs = activities.filter((activity) => activity.sport === "run");
const longest = runs.toSorted((a, b) => b.distanceKm - a.distanceKm)[0];
const latestVo2 = vo2.at(-1);

const stats = [
  { label: "Running distance", value: formatNumber(sum(runs.map((run) => run.distanceKm))), unit: " km", detail: formatCount(runs.length, "run") },
  { label: "Active time", value: formatDuration(sum(activities.map((item) => item.durationSec))), detail: formatCount(activities.length, "activity") },
  { label: "Longest run", value: formatNumber(longest?.distanceKm ?? null, 1), unit: " km", detail: longest && formatWeekday(longest.date) },
  { label: "VO2 max", value: formatNumber(latestVo2?.value ?? null, 1), detail: latestVo2 && vo2[0] && `Started at ${formatNumber(vo2[0].value, 1)}` },
].filter((stat) => stat.value !== "–");

// Every month of the year gets a column, even those still to come
const describe = <T,>(bucket: { month: string; isPartial: boolean; items: T[] }) => ({
  ...bucket,
  label: formatMonthName(bucket.month),
  title: `${formatMonthTitle(bucket.month)}${bucket.isPartial ? ", so far" : ""}`,
});
const activityMonths = bucketByMonth(activities, calendar, today).map(describe);
const dayMonths = bucketByMonth(days, calendar, today).map(describe);
const nightMonths = bucketByMonth(nights, calendar, today).map(describe);

const monthly = dayMonths.map((bucket) => ({
  ...bucket,
  steps: average(bucket.items.filter((day) => !day.isToday).map((day) => day.steps)),
  restingHr: average(bucket.items.map((day) => day.restingHr)),
  stress: average(bucket.items.filter((day) => !day.isToday).map((day) => day.stress)),
}));
const sleep = nightMonths.map((bucket) => ({ ...bucket, seconds: average(bucket.items.map((night) => night.totalSec)) }));

const points = (rows: Array<{ label: string; title: string; value: number | null }>, unit: string, color: string) =>
  rows.map((row) => ({
    label: row.label,
    value: row.value,
    tip: { title: row.title, rows: [row.value == null ? { label: "", value: "No data" } : { label: unit, value: formatNumber(row.value), color }] },
  }));

const monthTable = (head: string, rows: Array<{ title: string; value: number | null }>) => ({
  head: ["Month", head],
  rows: rows.map((row) => [row.title, formatNumber(row.value)]),
});

const stepRows = monthly.map((row) => ({ ...row, value: row.steps }));
const heartRows = monthly.map((row) => ({ ...row, value: row.restingHr }));
const stressRows = monthly.map((row) => ({ ...row, value: row.stress }));
const stepColumns = points(stepRows, "steps per day", "var(--steps)").map((point) => ({
  label: point.label,
  tip: point.tip,
  segments: point.value ? [{ value: point.value, color: "var(--steps)" }] : [],
}));
const sleepColumns = sleep.map((row) => ({
  label: row.label,
  isMuted: row.isPartial,
  segments: row.seconds ? [{ value: row.seconds / 3600, color: "var(--sleep)" }] : [],
  tip: {
    title: row.title,
    rows: row.seconds
      ? [
          { label: "average", value: formatDuration(row.seconds), color: "var(--sleep)" },
          { label: "nights", value: String(row.items.length) },
        ]
      : [{ label: "", value: "Not recorded" }],
  },
}));

const vo2Weeks = latestPerWeek(vo2, period);
const vo2Points = vo2Weeks.map(({ start, reading }) => ({
  label: formatDay(start),
  value: reading?.value ?? null,
  tip: {
    title: `Week of ${formatDay(start)}`,
    rows: [reading ? { label: "VO2 max", value: formatNumber(reading.value, 1), color: "var(--fitness)" } : { label: "", value: "No reading" }],
  },
}));

const hasWellness = monthly.some((row) => row.steps != null || row.restingHr != null || row.stress != null);
const yearSteps = average(days.filter((day) => !day.isToday).map((day) => day.steps));
const yearHeart = average(days.map((day) => day.restingHr));
const yearSleep = average(nights.map((night) => night.totalSec));

const tableRows = activityMonths
  .map((bucket, index) => ({ month: bucket.month, activities: bucket.items, days: dayMonths[index]!.items }))
  .filter((row) => row.month <= today.slice(0, 7));
---

<ResultsLine stats={stats} />
<YearHeatmap activities={activities} range={calendar} today={today} months={months} />
<PageSection title="Training">
  <div class="twoColumns">
    <RunDistancePanel title="Running distance per month" unit="Month" note="In kilometers" buckets={activityMonths} />
    <TimeBySportPanel title="Time per month" unit="Month" buckets={activityMonths} />
  </div>
  {vo2.length > 0 && (
    <ChartPanel
      title="VO2 max"
      note="In ml/kg/min, latest reading of each week"
      table={{
        head: ["Week of", "VO2 max"],
        rows: vo2Weeks.flatMap(({ start, reading }) => (reading ? [[formatDay(start), formatNumber(reading.value, 1)]] : [])),
      }}
    >
      <LineChart points={vo2Points} summary="Weekly VO2 max" color="var(--fitness)" connectGaps />
    </ChartPanel>
  )}
  <RunFormPanel activities={activities} period={period} />
  <MonthTable rows={tableRows} months={months} />
</PageSection>
<PageSection title="Body">
  {!hasWellness && nights.length === 0 && <p class="notice">The watch recorded no daily data this year, so there are no steps, heart rate or sleep charts.</p>}
  {(hasWellness || nights.length > 0) && (
    <div class="twoColumns">
      {monthly.some((row) => row.steps != null) && (
        <ChartPanel title="Daily steps" note={`${formatNumber(yearSteps)} per day on average`} table={monthTable("Steps", stepRows)}>
          <ColumnChart columns={stepColumns} summary="Average daily steps per month" />
        </ChartPanel>
      )}
      {monthly.some((row) => row.restingHr != null) && (
        <ChartPanel title="Resting heart rate" note={`${formatNumber(yearHeart)} bpm on average`} table={monthTable("bpm", heartRows)}>
          <LineChart points={points(heartRows, "bpm at rest", "var(--heart)")} summary="Resting heart rate per month" color="var(--heart)" />
        </ChartPanel>
      )}
      {monthly.some((row) => row.stress != null) && (
        <ChartPanel title="Stress" note="Monthly average, on a scale of 0 to 100" table={monthTable("Stress", stressRows)}>
          <LineChart points={points(stressRows, "stress", "var(--stress)")} summary="Average stress per month" color="var(--stress)" domain={[0, 60]} />
        </ChartPanel>
      )}
      {nights.length > 0 && (
        <ChartPanel
          title="Time asleep"
          note={`${formatDuration(yearSleep)} on average over ${formatCount(nights.length, "recorded night")}`}
          table={{
            head: ["Month", "Average", "Nights"],
            rows: sleep.map((row) => [row.title, formatDuration(row.seconds), String(row.items.length)]),
          }}
        >
          <ColumnChart columns={sleepColumns} summary="Average time asleep per month" formatTick={(value) => `${value}h`} />
        </ChartPanel>
      )}
    </div>
  )}
</PageSection>
<PageSection title="Effort">
  <div class="threeColumns">
    <ZonesPanel activities={activities} />
    <SportsPanel activities={activities} />
    <EffortsPanel activities={activities} />
  </div>
</PageSection>
