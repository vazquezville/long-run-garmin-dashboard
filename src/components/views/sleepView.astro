---
import { average } from "../../lib/data/aggregate.ts";
import type { Day, HrvReading, Night } from "../../lib/data/types.ts";
import { formatCount, formatDay, formatDuration, formatLabel, formatNumber, formatWeekday } from "../../lib/format.ts";
import { lastDays, listDays } from "../../lib/garmin/ranges.ts";
import { within, type Range } from "../../lib/views.ts";
import ChartPanel from "../charts/chartPanel.astro";
import LineChart from "../charts/lineChart.astro";
import BatteryChart from "../metrics/batteryChart.astro";
import SleepStagesChart from "../metrics/sleepStagesChart.astro";
import StressChart from "../metrics/stressChart.astro";
import PageSection from "../pageSection.astro";
import ResultsLine from "../resultsLine.astro";

interface Props {
  range: Range;
  today: string;
  nights: Night[];
  hrv: HrvReading[];
  days: Day[];
}

const { range, today, nights, hrv, days } = Astro.props;
const period = lastDays(range, today);
const dates = listDays(period);
const slept = within(nights, period);
const readings = within(hrv, period);
const shown = within(days, period);
const meanSleep = average(slept.map((night) => night.totalSec));

const stats = [
  { label: "Time asleep", value: formatDuration(meanSleep), detail: "Average per recorded night" },
  { label: "Nights recorded", value: formatNumber(slept.length), unit: ` of ${range}` },
  { label: "Sleep score", value: formatNumber(average(slept.map((night) => night.score))), detail: "Average" },
  { label: "Heart rate asleep", value: formatNumber(average(slept.map((night) => night.avgHr))), unit: " bpm", detail: "Average" },
  { label: "HRV overnight", value: formatNumber(average(readings.map((reading) => reading.value))), unit: " ms", detail: formatCount(readings.length, "reading") },
];

const nightByDate = new Map(slept.map((night) => [night.date, night]));
const scorePoints = dates.map((date) => {
  const night = nightByDate.get(date);
  const label = night?.scoreLabel ? formatLabel(night.scoreLabel).toLowerCase() : "score";
  return {
    label: formatDay(date),
    value: night?.score ?? null,
    tip: { title: formatWeekday(date), rows: [night?.score != null ? { label, value: String(night.score), color: "var(--sleep)" } : { label: "", value: "Not recorded" }] },
  };
});

const readingByDate = new Map(readings.map((reading) => [reading.date, reading]));
const latest = readings.findLast((reading) => reading.balancedLow != null && reading.balancedHigh != null);
const baseline = latest ? { from: latest.balancedLow!, to: latest.balancedHigh! } : undefined;
const hrvPoints = dates.map((date) => {
  const reading = readingByDate.get(date);
  return {
    label: formatDay(date),
    value: reading?.value ?? null,
    tip: { title: formatWeekday(date), rows: [reading ? { label: "ms", value: formatNumber(reading.value), color: "var(--sleep)" } : { label: "", value: "No reading" }] },
  };
});

const noNights = slept.length === 0 && `No sleep recorded in the last ${range} days. Wear your watch overnight, or pick a longer range.`;
---

<ResultsLine stats={stats} />
<SleepStagesChart nights={slept} range={period} empty={noNights} height={280} isLead />
<PageSection title="Score and variability">
  <div class="twoColumns">
    <ChartPanel
      title="Sleep score"
      note="Out of 100, for each recorded night"
      table={{ head: ["Night", "Score"], rows: slept.toReversed().map((night) => [formatWeekday(night.date), formatNumber(night.score)]) }}
      empty={noNights}
    >
      <LineChart points={scorePoints} summary="Sleep score per night" color="var(--sleep)" domain={[0, 100]} showLine={false} />
    </ChartPanel>
    <ChartPanel
      title="Heart rate variability"
      note={baseline ? `Overnight average in ms, the shaded band is your balanced range of ${baseline.from} to ${baseline.to}` : "Overnight average in ms"}
      table={{ head: ["Date", "HRV"], rows: readings.toReversed().map((reading) => [formatWeekday(reading.date), formatNumber(reading.value)]) }}
      empty={readings.length === 0 && `No HRV readings in the last ${range} days.`}
    >
      <LineChart points={hrvPoints} summary="Overnight heart rate variability" color="var(--sleep)" band={baseline} showLine={false} />
    </ChartPanel>
  </div>
</PageSection>
<PageSection title="Recovery">
  <div class="twoColumns">
    <BatteryChart days={shown} />
    <StressChart days={shown} />
  </div>
</PageSection>
