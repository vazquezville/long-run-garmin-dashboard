---
import type { Activity } from "../lib/data/types.ts";
import { formatClock, formatFullWeekday, formatNumber } from "../lib/format.ts";
import { sessionKinds, sessionName } from "../lib/sessionKind.ts";

interface Props {
  run: Activity;
  hidden?: boolean;
}

const { run, hidden = false } = Astro.props;
---

<li hidden={hidden}>
  <span class="distance condensed">{formatNumber(run.distanceKm, 1)}</span>
  <div>
    <strong><a href={`/run/${run.id}`}>{sessionName(run.name)}</a></strong>
    <p class="muted">
      <span class="kind" style={`color: ${sessionKinds[run.kind].color}`}>{sessionKinds[run.kind].label}</span>, {formatFullWeekday(run.date)}
    </p>
  </div>
  <div>
    <b class="condensed">{formatClock(run.paceSecPerKm)}</b>
    <span class="muted">per km</span>
  </div>
  <div class="extra">
    <b class="condensed">{formatNumber(run.avgHr)}</b>
    <span class="muted">bpm</span>
  </div>
  <div class="extra">
    <b class="condensed">{formatNumber(run.trainingLoad)}</b>
    <span class="muted">load</span>
  </div>
</li>

<style>
  li {
    position: relative;
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr) repeat(3, 100px);
    align-items: center;
    gap: 20px;
    padding: 14px 8px;
    border-top: 2px solid var(--ink);
  }

  li:hover {
    background: var(--quiet);
  }

  li[hidden] {
    display: none;
  }

  a {
    text-decoration: none;
  }

  /* The whole row opens the run */
  a::after {
    position: absolute;
    inset: 0;
    content: "";
  }

  a:focus-visible {
    outline: 0;
  }

  a:focus-visible::after {
    outline: 3px solid var(--ink);
    outline-offset: -3px;
  }

  .distance {
    font-size: 54px;
  }

  strong {
    font-size: 18px;
    overflow-wrap: anywhere;
  }

  .kind {
    font-weight: 700;
  }

  b {
    display: block;
    font-size: 28px;
  }

  @media (max-width: 900px) {
    li {
      grid-template-columns: 90px minmax(0, 1fr) 70px;
    }

    .extra {
      display: none;
    }

    .distance {
      font-size: 40px;
    }
  }
</style>
