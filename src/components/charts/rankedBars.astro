---
interface Props {
  rows: Array<{ label: string; detail?: string; value: number; display: string; color: string }>;
}

const { rows } = Astro.props;
const max = Math.max(...rows.map((row) => row.value), 1);
---

<ul>
  {rows.map((row) => (
    <li>
      <span class="label">
        {row.label}
        {row.detail && <span class="muted">{row.detail}</span>}
      </span>
      <span class="track">
        {row.value > 0 && <span class="bar" style={`width: ${(row.value / max) * 100}%; background: ${row.color}`} />}
      </span>
      <span class="value">{row.display}</span>
    </li>
  ))}
</ul>

<style>
  ul {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
    container-type: inline-size;
    margin-top: 16px;
  }

  li {
    display: grid;
    grid-template-columns: minmax(0, 8.5rem) minmax(0, 1fr) 5rem;
    align-items: center;
    gap: 12px;
    font-size: 13px;
  }

  .label {
    display: grid;
    line-height: 1.3;
  }

  .label .muted {
    font-size: 12px;
  }

  .bar {
    display: block;
    height: 14px;
    border-radius: 0 4px 4px 0;
  }

  .track {
    border-left: 1px solid var(--axis);
  }

  .value {
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  /* The bar drops under the name when space is tight */
  @container (max-width: 360px) {
    li {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 4px 12px;
    }

    .track {
      grid-row: 2;
      grid-column: 1 / -1;
    }
  }
</style>
