---
import type { TableData } from "../../lib/chart.ts";

interface Props {
  table: TableData;
}

const { head, rows } = Astro.props.table;
---

<details>
  <summary>Show data</summary>
  <div class="tableScroll">
    <table>
      <thead>
        <tr>{head.map((cell) => <th scope="col">{cell}</th>)}</tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr>{row.map((cell) => <td>{cell}</td>)}</tr>
        ))}
      </tbody>
    </table>
  </div>
</details>

<style>
  details {
    margin-top: 8px;
    font-size: 13px;
  }

  summary {
    width: fit-content;
    color: var(--textMuted);
    cursor: pointer;
  }

  .tableScroll {
    max-height: 280px;
    margin-top: 8px;
  }
</style>
