---
import type { Stat } from "../lib/chart.ts";

interface Props {
  // The first figure leads the page
  stats: Stat[];
}

const { stats } = Astro.props;
---

<dl>
  {stats.map((stat, index) => (
    <div class:list={{ isLead: index === 0 }}>
      <dt>{stat.label}</dt>
      <dd class="value">
        {stat.value}
        {stat.unit && stat.value !== "–" && <span>{stat.unit}</span>}
      </dd>
      <dd class="detail">{stat.detail}</dd>
    </div>
  ))}
</dl>

<style>
  dl {
    display: grid;
    grid-auto-flow: column;
    grid-template-rows: auto auto auto;
    justify-content: start;
    column-gap: clamp(24px, 5.5vw, 76px);
    padding-top: 16px;
    border-top: 2px solid var(--text);
  }

  div {
    display: grid;
    grid-row: span 3;
    grid-template-rows: subgrid;
    row-gap: 0;
    align-content: start;
  }

  .value {
    grid-row: 1;
    align-self: baseline;
    font-size: 1.75rem;
    font-stretch: 115%;
    font-weight: 700;
    line-height: 1.15;
    white-space: nowrap;
  }

  .value span {
    color: var(--textMuted);
    font-size: 0.9rem;
    font-stretch: 100%;
    font-weight: 500;
  }

  .isLead .value {
    font-size: clamp(3.25rem, 7vw, 4.75rem);
    font-stretch: 122%;
    font-weight: 850;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .isLead .value span {
    font-size: 1.25rem;
    letter-spacing: 0;
  }

  dt {
    grid-row: 2;
    margin-top: 6px;
    font-size: 13px;
    font-weight: 600;
  }

  .detail {
    grid-row: 3;
    color: var(--textMuted);
    font-size: 12px;
  }

  @media (max-width: 1040px) {
    dl {
      grid-auto-flow: row;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      column-gap: 24px;
    }

    div {
      padding-bottom: 14px;
    }

    .isLead {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 480px) {
    dl {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 16px;
    }

    .value {
      font-size: 1.4rem;
    }
  }
</style>
