---
import ThemeToggle from "./themeToggle.astro";

const links = [
  { href: "/", label: "Overview" },
  { href: "/month", label: "Month" },
  { href: "/year", label: "Year" },
  { href: "/activities", label: "Activities" },
  { href: "/daily", label: "Daily" },
  { href: "/sleep", label: "Sleep" },
  { href: "/fitness", label: "Fitness" },
];
const current = Astro.url.pathname.replace(/(?<=.)\/$/, "");
const isCurrent = (href: string) => current === href || (href !== "/" && current.startsWith(`${href}/`));
---

<header>
  <div class="container">
    <a class="brand" href="/">
      <svg viewBox="0 0 32 20" width="32" height="20" aria-hidden="true">
        <rect x="1.5" y="1.5" width="29" height="17" rx="8.5" />
        <rect x="6.5" y="6.5" width="19" height="7" rx="3.5" />
      </svg>
      Logbook
    </a>
    <ThemeToggle />
    <nav aria-label="Sections">
      {links.map((link) => (
        <a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  /* Running track band with two lane lines */
  header {
    border-bottom: 2px solid rgba(255, 255, 255, 0.75);
    background: var(--track);
    box-shadow:
      0 5px 0 var(--track),
      0 6px 0 var(--axis);
    color: var(--trackText);
  }

  .container {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
    padding-top: 14px;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:focus-visible {
    outline-color: var(--trackText);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1.15rem;
    font-stretch: 122%;
    font-weight: 800;
  }

  .brand svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    width: 100%;
  }

  nav a {
    padding: 8px 12px 10px;
    border-bottom: 3px solid transparent;
    font-weight: 500;
    opacity: 0.8;
  }

  nav a:hover,
  nav a[aria-current="page"] {
    opacity: 1;
  }

  nav a[aria-current="page"] {
    border-bottom-color: var(--trackText);
    font-weight: 700;
  }

  nav a:focus-visible {
    outline-offset: -2px;
  }

  /* Two even rows on phones */
  @media (max-width: 560px) {
    nav {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0;
    }

    nav a {
      padding: 6px 0 7px;
      font-size: 14px;
      text-align: center;
    }
  }
</style>
