---
import { average } from "../../lib/data/aggregate.ts";
import type { Day } from "../../lib/data/types.ts";
import { formatDay, formatNumber, formatWeekday } from "../../lib/format.ts";
import ChartPanel from "../charts/chartPanel.astro";
import LineChart from "../charts/lineChart.astro";

interface Props {
  days: Day[];
  height?: number;
  isLead?: boolean;
}

const { days, height, isLead = false } = Astro.props;
const color = "var(--heart)";
const mean = average(days.map((day) => day.restingHr));

const points = days.map((day) => ({
  label: formatDay(day.date),
  value: day.restingHr,
  tip: {
    title: formatWeekday(day.date),
    rows: [{ label: "bpm at rest", value: formatNumber(day.restingHr), color }],
  },
}));

const table = {
  head: ["Date", "Resting", "Lowest", "Highest"],
  rows: days.toReversed().map((day) => [formatWeekday(day.date), formatNumber(day.restingHr), formatNumber(day.minHr), formatNumber(day.maxHr)]),
};
---

<ChartPanel
  isLead={isLead}
  title="Resting heart rate"
  note={mean == null ? undefined : `${formatNumber(mean)} bpm on average`}
  table={table}
  empty={mean == null && "No heart rate recorded in this period."}
>
  <LineChart points={points} summary="Resting heart rate per day" color={color} height={height} />
</ChartPanel>
