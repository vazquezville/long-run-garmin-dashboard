---
import { average } from "../../lib/data/aggregate.ts";
import type { Day } from "../../lib/data/types.ts";
import { formatDay, formatNumber, formatWeekday } from "../../lib/format.ts";
import ChartPanel from "../charts/chartPanel.astro";
import ColumnChart from "../charts/columnChart.astro";

interface Props {
  days: Day[];
  height?: number;
  isLead?: boolean;
}

const { days, height, isLead = false } = Astro.props;
const color = "var(--steps)";
const goal = days.findLast((day) => day.stepGoal != null)?.stepGoal;
const mean = average(days.filter((day) => !day.isToday).map((day) => day.steps));
const hasData = days.some((day) => day.steps != null);

const columns = days.map((day) => ({
  label: formatDay(day.date),
  isMuted: day.isToday,
  segments: day.steps ? [{ value: day.steps, color }] : [],
  tip: {
    title: `${formatWeekday(day.date)}${day.isToday ? ", so far" : ""}`,
    rows: [{ label: "steps", value: formatNumber(day.steps), color }],
  },
}));

const table = {
  head: ["Date", "Steps", "Goal"],
  rows: days.toReversed().map((day) => [formatWeekday(day.date), formatNumber(day.steps), formatNumber(day.stepGoal)]),
};
---

<ChartPanel
  isLead={isLead}
  title="Steps"
  note={[
    mean != null && `${formatNumber(mean)} per day on average, not counting today.`,
    goal && `The line marks your goal of ${formatNumber(goal)}.`,
  ]
    .filter(Boolean)
    .join(" ")}
  table={table}
  empty={!hasData && "No steps recorded in this period."}
>
  <ColumnChart columns={columns} summary="Steps per day" goal={goal ?? undefined} height={height} />
</ChartPanel>
