---
import { average } from "../../lib/data/aggregate.ts";
import type { Day } from "../../lib/data/types.ts";
import { formatDay, formatNumber, formatWeekday } from "../../lib/format.ts";
import ChartPanel from "../charts/chartPanel.astro";
import ColumnChart from "../charts/columnChart.astro";

interface Props {
  days: Day[];
  height?: number;
  isLead?: boolean;
}

const { days, height, isLead = false } = Astro.props;
const color = "var(--battery)";
const peak = average(days.filter((day) => !day.isToday).map((day) => day.batteryHigh));
const hasData = days.some((day) => day.batteryHigh != null);

const columns = days.map((day) => ({
  label: formatDay(day.date),
  isMuted: day.isToday,
  segments: day.batteryLow != null && day.batteryHigh != null ? [{ from: day.batteryLow, value: day.batteryHigh, color }] : [],
  tip: {
    title: `${formatWeekday(day.date)}${day.isToday ? ", so far" : ""}`,
    rows: [
      { label: "highest", value: formatNumber(day.batteryHigh), color },
      { label: "lowest", value: formatNumber(day.batteryLow), color },
      { label: "charged", value: formatNumber(day.batteryCharged) },
      { label: "drained", value: formatNumber(day.batteryDrained) },
    ],
  },
}));

const table = {
  head: ["Date", "Lowest", "Highest", "Charged", "Drained"],
  rows: days
    .toReversed()
    .map((day) => [formatWeekday(day.date), ...[day.batteryLow, day.batteryHigh, day.batteryCharged, day.batteryDrained].map((value) => formatNumber(value))]),
};
---

<ChartPanel
  isLead={isLead}
  title="Body Battery"
  note={peak == null ? "Daily low to high" : `Daily low to high, peaking at ${formatNumber(peak)} on average`}
  table={table}
  empty={!hasData && "No Body Battery readings in this period."}
>
  <ColumnChart columns={columns} summary="Body Battery range per day" max={100} height={height} />
</ChartPanel>
