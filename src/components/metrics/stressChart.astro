---
import { average } from "../../lib/data/aggregate.ts";
import type { Day } from "../../lib/data/types.ts";
import { formatDay, formatNumber, formatWeekday } from "../../lib/format.ts";
import ChartPanel from "../charts/chartPanel.astro";
import LineChart from "../charts/lineChart.astro";

interface Props {
  days: Day[];
  height?: number;
  isLead?: boolean;
}

const { days, height, isLead = false } = Astro.props;
const color = "var(--stress)";
const mean = average(days.filter((day) => !day.isToday).map((day) => day.stress));
const highest = Math.max(60, ...days.map((day) => day.stress ?? 0));

const points = days.map((day) => ({
  label: formatDay(day.date),
  value: day.stress,
  tip: {
    title: `${formatWeekday(day.date)}${day.isToday ? ", so far" : ""}`,
    rows: [{ label: "stress", value: formatNumber(day.stress), color }],
  },
}));

const table = {
  head: ["Date", "Average stress"],
  rows: days.toReversed().map((day) => [formatWeekday(day.date), formatNumber(day.stress)]),
};
---

<ChartPanel
  isLead={isLead}
  title="Stress"
  note={mean == null ? undefined : `${formatNumber(mean)} on average, on a scale of 0 to 100`}
  table={table}
  empty={!days.some((day) => day.stress != null) && "No stress readings in this period."}
>
  <LineChart points={points} summary="Average stress per day" color={color} domain={[0, highest]} height={height} />
</ChartPanel>
