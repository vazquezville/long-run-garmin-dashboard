---
import { formatMonthLong, formatMonthTitle } from "../lib/format.ts";
import { adjacent, yearsOf } from "../lib/periods.ts";

interface Props {
  kind: "month" | "year";
  selected: string;
  months: string[];
}

const { kind, selected, months } = Astro.props;
const { previous, next } = adjacent(kind === "month" ? months : yearsOf(months), selected);

// The year is only spelled out when the step crosses into another one
function name(id: string): string {
  if (kind === "year") return id;
  return id.slice(0, 4) === selected.slice(0, 4) ? formatMonthLong(id) : formatMonthTitle(id);
}
---

<nav aria-label={`Adjacent ${kind}s`}>
  {previous ? (
    <a href={`/${kind}/${previous}`} rel="prev" aria-label={`Previous ${kind}, ${name(previous)}`}>
      <span aria-hidden="true">‹</span>
      {name(previous)}
    </a>
  ) : (
    <i />
  )}
  {next && (
    <a href={`/${kind}/${next}`} rel="next" aria-label={`Next ${kind}, ${name(next)}`}>
      {name(next)}
      <span aria-hidden="true">›</span>
    </a>
  )}
</nav>

<style>
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  a {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border: 1px solid var(--axis);
    border-radius: 999px;
    color: var(--text);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
  }

  a:hover {
    background: var(--hover);
  }

  span {
    font-size: 18px;
    line-height: 1;
  }
</style>
