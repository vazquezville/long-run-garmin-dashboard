---
interface Props {
  // Null when there is nothing further that way
  href: string | null;
  label: string;
  direction: "prev" | "next";
}

const { href, label, direction } = Astro.props;
const arrow = direction === "prev" ? "‹" : "›";
---

{href ? (
  <a href={href} rel={direction} aria-label={label}>{arrow}</a>
) : (
  <span aria-hidden="true">{arrow}</span>
)}

<style>
  a,
  span {
    display: grid;
    flex: none;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 2.5px solid var(--ink);
    border-radius: 50%;
    font-size: 22px;
    font-weight: 800;
    line-height: 1;
    text-decoration: none;
  }

  span {
    opacity: 0.3;
  }
</style>
