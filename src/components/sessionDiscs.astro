---
import type { Activity } from "../lib/data/types.ts";
import { discSize } from "../lib/sessions.ts";
import { sports } from "../lib/sports.ts";

interface Props {
  activities: Activity[];
}

const { activities } = Astro.props;
---

{activities.map((activity) => <i style={`--size: ${discSize(activity.durationSec)}px; background: ${sports[activity.sport].color}`} />)}

<style>
  i {
    flex: none;
    width: calc(var(--size) * var(--scale, 1));
    height: calc(var(--size) * var(--scale, 1));
    border-radius: 50%;
    box-shadow: 0 0 0 2px var(--surface);
  }

  i + i {
    margin-left: var(--overlap, calc(-6px * var(--scale, 1)));
  }
</style>
