---
import { bestEffort, type Effort } from "../../lib/data/aggregate.ts";
import type { Activity } from "../../lib/data/types.ts";
import { formatClock, formatDay } from "../../lib/format.ts";
import EmptyState from "../emptyState.astro";

interface Props {
  activities: Activity[];
}

const { activities } = Astro.props;
const efforts: Array<[Effort, string]> = [
  ["km1", "1 km"],
  ["km5", "5 km"],
  ["km10", "10 km"],
  ["half", "Half marathon"],
];
const bests = efforts.flatMap(([key, label]) => {
  const best = bestEffort(activities, key);
  return best ? [{ label, ...best }] : [];
});
---

<section class="block">
  <h3>Fastest running efforts</h3>
  {bests.length === 0 ? (
    <EmptyState message="No timed splits in this period." />
  ) : (
    <table>
      <thead>
        <tr>
          <th scope="col">Distance</th>
          <th scope="col">Date</th>
          <th scope="col">Time</th>
        </tr>
      </thead>
      <tbody>
        {bests.map((best) => (
          <tr>
            <td>{best.label}</td>
            <td>{formatDay(best.date)}</td>
            <td class="effort">{formatClock(best.seconds)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  )}
</section>

<style>
  table {
    margin-top: 8px;
  }

  .effort {
    font-size: 1.4rem;
    font-stretch: 115%;
    font-weight: 750;
  }
</style>
