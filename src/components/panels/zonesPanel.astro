---
import { sum } from "../../lib/data/aggregate.ts";
import type { Activity } from "../../lib/data/types.ts";
import { formatDuration, formatNumber } from "../../lib/format.ts";
import ChartPanel from "../charts/chartPanel.astro";
import RankedBars from "../charts/rankedBars.astro";

interface Props {
  activities: Activity[];
}

const runs = Astro.props.activities.filter((activity) => activity.sport === "run");
const zones = [1, 2, 3, 4, 5].map((zone) => ({ zone, seconds: sum(runs.map((run) => run.zoneSec[zone - 1] ?? 0)) }));
const total = sum(zones.map((zone) => zone.seconds));
const rows = zones.map((zone) => ({
  label: `Zone ${zone.zone}`,
  detail: total ? `${formatNumber((zone.seconds / total) * 100)}%` : "",
  value: zone.seconds,
  display: formatDuration(zone.seconds),
  color: `var(--zone${zone.zone})`,
}));
---

<ChartPanel title="Heart rate zones while running" note="Time spent in each zone" empty={total === 0 && "No heart rate zone data in this period."}>
  <RankedBars rows={rows} />
</ChartPanel>
