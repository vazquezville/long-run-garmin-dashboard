---
import { bucketByDate, formAverage, hasForm, type FormMetric } from "../../lib/data/aggregate.ts";
import type { Activity } from "../../lib/data/types.ts";
import { formatCount, formatDay, formatNumber } from "../../lib/format.ts";
import type { DateRange } from "../../lib/garmin/ranges.ts";
import { sports } from "../../lib/sports.ts";
import ChartPanel from "../charts/chartPanel.astro";
import LineChart from "../charts/lineChart.astro";

interface Props {
  activities: Activity[];
  period: DateRange;
}

const { activities, period } = Astro.props;
const metrics: Array<[metric: FormMetric, label: string, unit: string, digits: number]> = [
  ["cadence", "Cadence", "spm", 0],
  ["strideM", "Stride length", "m", 2],
  ["groundContactMs", "Ground contact time", "ms", 0],
  ["oscillationCm", "Vertical oscillation", "cm", 1],
  ["verticalRatio", "Vertical ratio", "%", 1],
  ["powerW", "Power", "W", 0],
];
const runs = activities.filter((activity) => activity.sport === "run");
const measured = runs.filter(hasForm);
const figures = metrics.flatMap(([metric, label, unit, digits]) => {
  const value = formAverage(measured, metric);
  return value == null ? [] : [{ label, unit, value: formatNumber(value, digits) }];
});

// The margin keeps small weekly changes from looking dramatic
const trends: Array<[metric: FormMetric, label: string, unit: string, note: string, digits: number, margin: number]> = [
  ["cadence", "Cadence", "spm", "In steps per minute", 0, 5],
  ["strideM", "Stride length", "m", "In meters", 2, 0.05],
];
const weeks = bucketByDate(measured, period, "week");
const charts = trends.flatMap(([metric, label, unit, note, digits, margin]) => {
  const readings = weeks.map((week) => ({
    label: formatDay(week.start),
    title: `Week of ${formatDay(week.start)}${week.isPartial ? ", partial" : ""}`,
    value: formAverage(week.items, metric),
    runs: week.items.filter((run) => run.form[metric] != null).length,
  }));
  const recorded = readings.flatMap((reading) => (reading.value == null ? [] : [{ ...reading, value: reading.value }]));
  // A trend needs at least three weeks
  if (recorded.length < 3) return [];
  const values = recorded.map((reading) => reading.value);
  return [
    {
      title: `${label} per week`,
      note,
      domain: [Math.min(...values) - margin, Math.max(...values) + margin] as [number, number],
      formatTick: (value: number) => formatNumber(value, digits),
      points: readings.map((reading) => ({
        label: reading.label,
        value: reading.value,
        tip: {
          title: reading.title,
          rows:
            reading.value == null
              ? [{ label: "", value: "No runs recorded" }]
              : [
                  { label: unit, value: formatNumber(reading.value, digits), color: sports.run.color },
                  { label: reading.runs === 1 ? "run" : "runs", value: String(reading.runs) },
                ],
        },
      })),
      table: {
        head: ["Week of", unit, "Runs"],
        rows: recorded.toReversed().map((reading) => [reading.label, formatNumber(reading.value, digits), String(reading.runs)]),
      },
    },
  ];
});
---

{figures.length > 0 && (
  <section class="block">
    <h3>Running form</h3>
    <p class="muted">
      Time-weighted averages from {measured.length} of {formatCount(runs.length, "run")}
    </p>
    <dl>
      {figures.map((figure) => (
        <div>
          <dt>{figure.label}</dt>
          <dd>
            {figure.value} <span>{figure.unit}</span>
          </dd>
        </div>
      ))}
    </dl>
    {charts.length > 0 && (
      <div class="twoColumns trends">
        {charts.map((chart) => (
          <ChartPanel title={chart.title} note={chart.note} table={chart.table}>
            <LineChart points={chart.points} summary={chart.title} color={sports.run.color} domain={chart.domain} formatTick={chart.formatTick} connectGaps />
          </ChartPanel>
        ))}
      </div>
    )}
  </section>
)}

<style>
  p {
    font-size: 13px;
  }

  dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 16px 24px;
    margin-top: 12px;
  }

  .trends {
    margin-top: 28px;
  }

  /* Figures sit above their labels, as in the results line */
  dl div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
  }

  dt {
    font-size: 13px;
    font-weight: 600;
  }

  dd {
    font-size: 1.75rem;
    font-stretch: 115%;
    font-weight: 700;
    line-height: 1.15;
    white-space: nowrap;
  }

  dd span {
    color: var(--textMuted);
    font-size: 0.9rem;
    font-stretch: 100%;
    font-weight: 500;
  }

  @media (max-width: 480px) {
    dl {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 16px;
    }

    dd {
      font-size: 1.4rem;
    }
  }
</style>
