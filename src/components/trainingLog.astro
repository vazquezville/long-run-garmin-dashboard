---
import { bucketByDate, sum, weekStart } from "../lib/data/aggregate.ts";
import type { Activity } from "../lib/data/types.ts";
import { formatDay, formatDuration, formatNumber, formatWeekday } from "../lib/format.ts";
import { addDays, type DateRange } from "../lib/garmin/ranges.ts";
import { dayTip, tipText } from "../lib/sessions.ts";
import { sportOrder, sports } from "../lib/sports.ts";
import DataTable from "./charts/dataTable.astro";
import EmptyState from "./emptyState.astro";
import SessionDiscs from "./sessionDiscs.astro";

interface Props {
  activities: Activity[];
  range: DateRange;
}

const { activities, range } = Astro.props;
const weekdays = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];

const calendar = { start: weekStart(range.start), end: range.end };
const weeks = bucketByDate(activities, calendar, "week")
  .toReversed()
  .map((week) => ({
    start: week.start,
    runKm: sum(week.items.filter((item) => item.sport === "run").map((item) => item.distanceKm)),
    seconds: sum(week.items.map((item) => item.durationSec)),
    days: weekdays.map((_, index) => {
      const date = addDays(week.start, index);
      const done = week.items.filter((item) => item.date === date).toReversed();
      return { date, done, isOutside: date < range.start || date > range.end };
    }),
  }));

const present = sportOrder.filter((sport) => activities.some((activity) => activity.sport === sport));
const table = {
  head: ["Date", "Sport", "Distance", "Time"],
  rows: activities.map((activity) => [
    formatWeekday(activity.date),
    sports[activity.sport].label,
    activity.distanceKm > 0 ? `${formatNumber(activity.distanceKm, 1)} km` : "–",
    formatDuration(activity.durationSec),
  ]),
};
---

<section class="block" aria-label="Sessions by week">
  <ul class="legend">
    {present.map((sport) => (
      <li>
        <span class="swatch round" style={`--color: ${sports[sport].color}`} />
        {sports[sport].label}
      </li>
    ))}
    <li>Bigger circles are longer sessions</li>
  </ul>

  {activities.length === 0 && <EmptyState message="No activities in this period. Pick a longer range to see earlier sessions." />}

  <div class="log">
    <div class="row head" aria-hidden="true">
      <span>Week of</span>
      {weekdays.map((weekday) => (
        <span class="center">
          {weekday.slice(0, 1)}<span class="suffix">{weekday.slice(1)}</span>
        </span>
      ))}
      <span class="total">Run km</span>
      <span class="total time">Time</span>
    </div>
    {weeks.map((week) => (
      <div class="row">
        <span class="week">{formatDay(week.start)}</span>
        {week.days.map((day) => {
          if (day.done.length === 0) {
            return <span class:list={["day", { isOutside: day.isOutside }]}>{!day.isOutside && <i class="rest" />}</span>;
          }
          const tip = dayTip(day.date, day.done);
          return (
            <span class="day" tabindex="0" role="img" aria-label={tipText(tip)} data-tip={JSON.stringify(tip)}>
              <SessionDiscs activities={day.done} />
            </span>
          );
        })}
        <span class="total distance">{formatNumber(week.runKm, 1)}</span>
        <span class="total time">{formatDuration(week.seconds)}</span>
      </div>
    ))}
  </div>

  {activities.length > 0 && <DataTable table={table} />}
</section>

<style>
  .round {
    border-radius: 50%;
  }

  .log {
    margin-top: 12px;
  }

  .row {
    --scale: 1.2;
    display: grid;
    grid-template-columns: 4.5rem repeat(7, minmax(0, 1fr)) 6rem 5rem;
    align-items: center;
    min-height: 60px;
    border-top: 1px solid var(--grid);
  }

  .head {
    min-height: 32px;
    border-top: 0;
    color: var(--textMuted);
    font-size: 12px;
  }

  .center {
    text-align: center;
  }

  .week {
    color: var(--textMuted);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }

  .day {
    display: flex;
    align-items: center;
    align-self: stretch;
    justify-content: center;
    border-radius: 8px;
  }

  .day.isActive {
    background: var(--hover);
  }

  .rest {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--axis);
  }

  .total {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .row:not(.head) .distance {
    font-size: 1.6rem;
    font-stretch: 115%;
    font-weight: 750;
  }

  .row:not(.head) .time {
    color: var(--textMuted);
    font-size: 13px;
  }

  @media (max-width: 640px) {
    .row {
      --scale: 0.65;
      grid-template-columns: 3.2rem repeat(7, minmax(0, 1fr)) 3.2rem;
      min-height: 48px;
    }

    .head {
      font-size: 10px;
    }

    .week {
      font-size: 11px;
    }

    .row:not(.head) .distance {
      font-size: 1rem;
    }

    .time {
      display: none;
    }
  }

  @media (max-width: 400px) {
    .row {
      --scale: 0.5;
      --overlap: -4px;
      grid-template-columns: 2.8rem repeat(7, minmax(0, 1fr)) 2.8rem;
    }

    .suffix {
      display: none;
    }
  }
</style>
