---
import type { Night } from "../lib/data/types.ts";
import { formatDuration, formatLabel, formatNumber, formatWeekday } from "../lib/format.ts";
import { sleepStages } from "../lib/sleepStages.ts";

interface Props {
  night: Night;
}

const { night } = Astro.props;
const parts = sleepStages.map((stage) => ({ ...stage, seconds: night[stage.key] })).filter((part) => part.seconds > 0);
const total = parts.reduce((all, part) => all + part.seconds, 0);
const facts = [
  night.score != null ? `Score ${night.score}${night.scoreLabel ? `, ${formatLabel(night.scoreLabel).toLowerCase()}` : ""}` : null,
  night.avgHr != null ? `${formatNumber(night.avgHr)} bpm average heart rate` : null,
  night.avgStress != null ? `${formatNumber(night.avgStress)} average stress` : null,
].filter(Boolean);
---

<div class="block">
  <p class="muted">
    {formatWeekday(night.date)}
    {night.bedtime && night.wakeTime && `, ${night.bedtime} to ${night.wakeTime}`}
  </p>
  <p class="total">{formatDuration(night.totalSec)}</p>
  <div class="bar">
    {parts.map((part) => {
      const tip = { title: part.label, rows: [{ label: `${formatNumber((part.seconds / total) * 100)}%`, value: formatDuration(part.seconds), color: part.color }] };
      return (
        <span
          style={`flex-grow: ${part.seconds}; background: ${part.color}`}
          tabindex="0"
          role="img"
          aria-label={`${part.label}: ${formatDuration(part.seconds)}`}
          data-tip={JSON.stringify(tip)}
        />
      );
    })}
  </div>
  <ul class="legend">
    {parts.map((part) => (
      <li>
        <span class="swatch" style={`--color: ${part.color}`} />
        {part.label} {formatDuration(part.seconds)}
      </li>
    ))}
  </ul>
  <ul class="facts">
    {facts.map((fact) => <li>{fact}</li>)}
  </ul>
</div>

<style>
  .total {
    font-size: 2.5rem;
    font-stretch: 120%;
    font-weight: 800;
    line-height: 1.2;
  }

  .bar {
    display: flex;
    gap: 2px;
    height: 28px;
    margin: 8px 0 12px;
  }

  .bar span {
    flex-basis: 0;
    min-width: 4px;
    border-radius: 4px;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
    margin-top: 12px;
    font-size: 13px;
  }
</style>
