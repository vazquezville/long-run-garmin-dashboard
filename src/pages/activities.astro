---
import ActivitiesView from "../components/views/activitiesView.astro";
import DashboardLayout from "../layouts/dashboardLayout.astro";
import { createSource } from "../lib/data/source.ts";
import { rangeOptions } from "../lib/views.ts";

const source = createSource();
const activities = await source.activities();
---

<DashboardLayout title="Activities" errors={[activities.error]}>
  {rangeOptions.map((range) => (
    <div data-range-panel={range}>
      <ActivitiesView range={range} today={source.today} activities={activities.data ?? []} />
    </div>
  ))}
</DashboardLayout>
