---
import PeriodPicker from "../../components/periodPicker.astro";
import PeriodSteps from "../../components/periodSteps.astro";
import YearView from "../../components/views/yearView.astro";
import DashboardLayout from "../../layouts/dashboardLayout.astro";
import { createSource } from "../../lib/data/source.ts";
import { upTo, yearRange, yearsOf } from "../../lib/periods.ts";

const source = createSource();
const months = await source.months();
const years = yearsOf(months);
// The bare /year address shows the current one
const id = Astro.params.year ?? years.at(-1)!;
if (!years.includes(id)) return new Response("Year not found", { status: 404 });
const calendar = yearRange(id);
const period = upTo(calendar, source.today);
const [activities, days, nights, vo2] = await Promise.all([source.activities(period), source.days(period), source.nights(period), source.vo2(period)]);
---

<DashboardLayout title={id} errors={[activities.error, days.error, nights.error, vo2.error]} hasRange={false}>
  <PeriodSteps slot="actions" kind="year" selected={id} months={months} />
  <PeriodPicker kind="year" selected={id} months={months} />
  <YearView
    today={source.today}
    calendar={calendar}
    period={period}
    months={months}
    activities={activities.data ?? []}
    days={days.data ?? []}
    nights={nights.data ?? []}
    vo2={vo2.data ?? []}
  />
</DashboardLayout>
