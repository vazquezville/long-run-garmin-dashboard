---
import ChartPanel from "../components/charts/chartPanel.astro";
import LineChart from "../components/charts/lineChart.astro";
import EmptyState from "../components/emptyState.astro";
import PageSection from "../components/pageSection.astro";
import ResultsLine from "../components/resultsLine.astro";
import DashboardLayout from "../layouts/dashboardLayout.astro";
import { average, latestPerWeek } from "../lib/data/aggregate.ts";
import { createSource } from "../lib/data/source.ts";
import type { FitnessFactor } from "../lib/data/types.ts";
import { formatDay, formatFullDate, formatMonth, formatNumber } from "../lib/format.ts";
import { lastDays } from "../lib/garmin/ranges.ts";
import { within } from "../lib/views.ts";

const source = createSource();
const [vo2, fitness, weights, zones, days] = await Promise.all([
  source.vo2(),
  source.fitnessAge(),
  source.weights(),
  source.heartRateZones(),
  source.days(),
]);

const latestVo2 = vo2.data?.at(-1);
const firstVo2 = vo2.data?.[0];
const latestWeight = weights.data?.at(-1);
const age = fitness.data;
const resting = average(within(days.data ?? [], lastDays(28, source.today)).map((day) => day.restingHr));

const stats = [
  {
    label: "VO2 max",
    value: formatNumber(latestVo2?.value ?? null, 1),
    detail: latestVo2 && firstVo2 ? `Was ${formatNumber(firstVo2.value, 1)} on ${formatFullDate(firstVo2.date)}` : undefined,
  },
  { label: "Fitness age", value: formatNumber(age ? Math.floor(age.fitnessAge) : null), detail: age ? `Actual age ${age.age}` : undefined },
  {
    label: "Weight",
    value: formatNumber(latestWeight?.kg ?? null, 1),
    unit: latestWeight ? " kg" : "",
    detail: latestWeight ? `Last logged ${formatFullDate(latestWeight.date)}` : "Not logged",
  },
  { label: "Resting heart rate", value: formatNumber(resting), unit: " bpm", detail: "Last 28 days" },
];

const vo2Weeks = latestPerWeek(vo2.data ?? [], source.lastYear);
const vo2Points = vo2Weeks.map(({ start, reading }) => ({
  label: formatMonth(start),
  value: reading?.value ?? null,
  tip: {
    title: `Week of ${formatDay(start)}`,
    rows: [reading ? { label: "VO2 max", value: formatNumber(reading.value, 1), color: "var(--fitness)" } : { label: "", value: "No reading" }],
  },
}));

const weightWeeks = latestPerWeek(weights.data ?? [], source.lastTwoYears);
const weightPoints = weightWeeks.map(({ start, reading }) => ({
  label: formatMonth(start),
  value: reading?.kg ?? null,
  tip: {
    title: `Week of ${formatDay(start)}`,
    rows: [reading ? { label: "kg", value: formatNumber(reading.kg, 1), color: "var(--accent)" } : { label: "", value: "Not logged" }],
  },
}));

const factors: Array<[label: string, factor: FitnessFactor, digits: number]> = age
  ? [
      ["Resting heart rate", age.restingHr, 0],
      ["Vigorous days per week", age.vigorousDays, 1],
      ["Vigorous minutes per week", age.vigorousMinutes, 0],
      ["Body mass index", age.bmi, 1],
    ]
  : [];
---

<DashboardLayout title="Fitness and body" errors={[vo2.error, fitness.error, weights.error, zones.error, days.error]} hasRange={false}>
  <ResultsLine stats={stats} />
  <ChartPanel
    title="VO2 max over the last year"
    note="In ml/kg/min, latest reading of each week"
    table={{
      head: ["Week of", "VO2 max"],
      rows: vo2Weeks.toReversed().flatMap(({ start, reading }) => (reading ? [[formatFullDate(start), formatNumber(reading.value, 1)]] : [])),
    }}
    empty={!latestVo2 && "No VO2 max readings yet. Record an outdoor run with heart rate to get one."}
    isLead
  >
    <LineChart points={vo2Points} summary="Weekly VO2 max" color="var(--fitness)" connectGaps height={300} />
  </ChartPanel>
  <PageSection title="Weight">
    <ChartPanel
      title="Last two years"
      note="In kilograms, latest entry of each week"
      table={{
        head: ["Date", "kg"],
        rows: (weights.data ?? []).toReversed().map((reading) => [formatFullDate(reading.date), formatNumber(reading.kg, 1)]),
      }}
      empty={!latestWeight && "No weight logged. Add it in Garmin Connect to see the trend."}
    >
      <LineChart points={weightPoints} summary="Weekly weight" color="var(--accent)" connectGaps showLine height={200} />
    </ChartPanel>
  </PageSection>
  <PageSection title="Fitness age and zones">
    <div class="twoColumns">
      <div class="block">
        <h3>What shapes your fitness age</h3>
        {age ? (
          <>
            {age.achievableAge && <p class="muted">Achievable fitness age: {Math.floor(age.achievableAge)}</p>}
            <table>
              <thead>
                <tr>
                  <th scope="col">Factor</th>
                  <th scope="col">Yours</th>
                  <th scope="col">Target</th>
                </tr>
              </thead>
              <tbody>
                {factors.map(([label, factor, digits]) => (
                  <tr>
                    <td>{label}</td>
                    <td>{formatNumber(factor.value, digits)}</td>
                    <td>{formatNumber(factor.target, digits)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </>
        ) : (
          <EmptyState message="Garmin hasn't calculated a fitness age yet." />
        )}
      </div>
      <div class="block">
        <h3>Heart rate zones</h3>
        {zones.data?.length ? (
          <table>
            <thead>
              <tr>
                <th scope="col">Zone</th>
                <th scope="col">Beats per minute</th>
              </tr>
            </thead>
            <tbody>
              {zones.data.map((zone) => (
                <tr>
                  <td>
                    <span class="zone">
                      <span class="swatch" style={`--color: var(--zone${zone.zone})`} />
                      Zone {zone.zone}
                    </span>
                  </td>
                  <td>{zone.to ? `${zone.from} to ${zone.to}` : `${zone.from} and up`}</td>
                </tr>
              ))}
            </tbody>
          </table>
        ) : (
          <EmptyState message="No heart rate zones configured." />
        )}
      </div>
    </div>
  </PageSection>
</DashboardLayout>

<style>
  table {
    margin-top: 8px;
  }

  .muted {
    font-size: 13px;
  }

  .zone {
    display: flex;
    align-items: center;
    gap: 8px;
  }
</style>
