---
import PeriodPicker from "../../components/periodPicker.astro";
import PeriodSteps from "../../components/periodSteps.astro";
import MonthView from "../../components/views/monthView.astro";
import DashboardLayout from "../../layouts/dashboardLayout.astro";
import { createSource } from "../../lib/data/source.ts";
import { formatMonthTitle } from "../../lib/format.ts";
import { monthRange, upTo } from "../../lib/periods.ts";

const source = createSource();
const months = await source.months();
// The bare /month address shows the current one
const id = Astro.params.month ?? months.at(-1)!;
if (!months.includes(id)) return new Response("Month not found", { status: 404 });
const calendar = monthRange(id);
const period = upTo(calendar, source.today);
const [activities, days, nights, vo2] = await Promise.all([source.activities(period), source.days(period), source.nights(period), source.vo2(period)]);
---

<DashboardLayout title={formatMonthTitle(id)} errors={[activities.error, days.error, nights.error, vo2.error]} hasRange={false}>
  <PeriodSteps slot="actions" kind="month" selected={id} months={months} />
  <PeriodPicker kind="month" selected={id} months={months} />
  <MonthView
    today={source.today}
    calendar={calendar}
    period={period}
    activities={activities.data ?? []}
    days={days.data ?? []}
    nights={nights.data ?? []}
    vo2={vo2.data ?? []}
  />
</DashboardLayout>
